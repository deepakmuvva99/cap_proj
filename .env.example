# =============================================================
# AI Invoice Auditor – Environment Configuration
# =============================================================

# PostgreSQL Configuration
POSTGRES_DB=invoicedb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Redis Cache
REDIS_HOST=redis
REDIS_PORT=6379

# Qdrant Vector Store
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_COLLECTION=invoice_audit_rag

# Service Inter-Communication URLs
ERP_SERVICE_URL=http://mock-erp:8000
AGENT_SERVICE_URL=http://agent:8000

# AWS Bedrock Authentication (Fill with your AWS credentials)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# AWS Bedrock Models
MODEL_REASONING=amazon.nova-lite-v1:0
MODEL_RAG_GENERATION=cohere.command-r-plus-v1:0
MODEL_TRANSLATION=cohere.command-r-plus-v1:0
MODEL_EMBEDDING=amazon.titan-embed-text-v2:0

# Directories
INCOMING_DIR=/data/incoming
OUTPUT_REPORTS_DIR=/app/outputs/reports
